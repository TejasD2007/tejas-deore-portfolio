---
---

<section
  id="about"
  class="about-section relative overflow-hidden py-16 md:py-24 border-t border-[#ffffff10] text-[var(--white)]"
>
  <!-- Ambient background -->
  <div class="about-glow about-glow-one"></div>
  <div class="about-glow about-glow-two"></div>

  <div class="max-w-6xl mx-auto relative z-10">

    <!-- =========================
         SECTION HEADER
         ========================= -->

    <div class="about-header">

      <div class="about-label">
        <span>About me</span>
        <span class="about-label-line"></span>
      </div>

      <h2 class="text-5xl md:text-6xl font-medium leading-tight mt-5">
        A little{" "}
        <span class="about-gradient-text">about me</span>
      </h2>

      <div class="about-roles">
        <span>STUDENT</span>
        <span class="role-cross">×</span>
        <span>DEVELOPER</span>
        <span class="role-cross">×</span>
        <span>PROBLEM SOLVER</span>
      </div>

    </div>


    <!-- =========================
         MAIN ABOUT LAYOUT
         ========================= -->

    <div
      class="grid grid-cols-1 lg:grid-cols-[1.25fr_0.75fr] gap-12 lg:gap-16 mt-12 md:mt-16"
    >

      <!-- =========================
           LEFT — ABOUT TEXT
           ========================= -->

      <div class="about-text space-y-6">

        <!-- Paragraph 1 -->
        <div class="about-paragraph">

          <div class="about-accent"></div>

          <p>
            I'm Tejas Deore, a Computer Engineering student focused on{" "}
            <span class="highlight">Artificial Intelligence</span>
            , Machine Learning, and software development.
          </p>

        </div>


        <!-- Paragraph 2 -->
        <div class="about-paragraph">

          <div class="about-accent"></div>

          <p>
            I enjoy turning ideas into practical software and exploring how
            intelligent systems can solve{" "}
            <span class="highlight">real-world problems</span>.
            {" "}My interests span AI, Generative AI, AI agents, web development,
            and core programming.
          </p>

        </div>


        <!-- Paragraph 3 -->
        <div class="about-paragraph">

          <div class="about-accent"></div>

          <p>
            I'm continuously strengthening my foundations in Data Structures &
            Algorithms and Object-Oriented Programming while{" "}
            <span class="highlight">building projects</span>,
            {" "}experimenting with new technologies, and{" "}
            <span class="highlight">
              learning through practical problem solving
            </span>.
          </p>

        </div>


        <!-- Paragraph 4 -->
        <div class="about-paragraph about-paragraph-last">

          <div class="about-accent"></div>

          <p>
            Currently, I'm pursuing my B.Tech in Computer Engineering at{" "}
            <span class="highlight">
              MIT Academy of Engineering, Pune
            </span>.
          </p>

        </div>

      </div>


      <!-- =========================
           RIGHT — VISUAL AREA
           ========================= -->

      <div class="about-visual">

        <!-- =========================
             MAIN FEATURE CARD
             ========================= -->

        <div class="about-feature-card">

          <!-- Ambient orb -->
          <div class="feature-orb"></div>


          <!-- =========================
               LEARNING BADGE
               ========================= -->

          <div class="feature-top">

            <div class="learning-badge">

              <span class="learning-dot"></span>

              <span>
                Always<br />
                learning
              </span>

            </div>

          </div>


          <!-- =========================
               PROFILE PHOTO
               ========================= -->

          <div class="feature-center">

            <div class="photo-frame">

              <div class="photo-glow"></div>

              <img
                src="/images/tejas.png"
                alt="Tejas Deore"
                class="about-photo"
              />

              <div class="photo-overlay"></div>

            </div>


            <!-- Decorative lines -->

            <div class="feature-lines">
              <span></span>
              <span></span>
              <span></span>
            </div>

          </div>


          <!-- =========================
               BOTTOM STATEMENT
               ========================= -->

          <div class="feature-bottom">

            <div class="feature-accent-line"></div>

            <p>
              Turning ideas<br />
              into <span>impact.</span>
            </p>

          </div>

        </div>


        <!-- =========================
             INFORMATION CARDS
             ========================= -->

        <div class="about-info-grid">

          <!-- EDUCATION -->

          <div class="about-info-card">

            <div class="info-icon">

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 10L12 5 2 10l10 5 10-5Z" />
                <path d="M6 12v5c3 2 9 2 12 0v-5" />
                <path d="M22 10v6" />
              </svg>

            </div>

            <div>

              <h3>B.Tech</h3>

              <p>
                COMPUTER ENGINEERING<br />
                MIT AOE, PUNE
              </p>

            </div>

          </div>


          <!-- EXPLORING -->

          <div class="about-info-card">

            <div class="info-icon">

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8Z" />
              </svg>

            </div>

            <div>

              <h3>Exploring</h3>

              <p>
                AI & EMERGING<br />
                TECHNOLOGIES
              </p>

            </div>

          </div>


          <!-- BUILDING -->

          <div class="about-info-card">

            <div class="info-icon">

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="16 18 22 12 16 6" />
                <polyline points="8 6 2 12 8 18" />
              </svg>

            </div>

            <div>

              <h3>Building</h3>

              <p>
                REAL-WORLD<br />
                PROJECTS
              </p>

            </div>

          </div>


          <!-- CURIOSITY -->

          <div class="about-info-card">

            <div class="info-icon">

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 18h6" />
                <path d="M10 22h4" />

                <path
                  d="M8.5 14.5C7.55 13.7 7 12.45 7 11a5 5 0 0 1 10 0c0 1.45-.55 2.7-1.5 3.5-.65.55-1.05 1.15-1.25 1.5h-4.5c-.2-.35-.6-.95-1.25-1.5Z"
                />

              </svg>

            </div>

            <div>

              <h3>Driven by</h3>

              <p>
                CURIOSITY &<br />
                IMPACT
              </p>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<style>

  /* =========================================
     SECTION
     ========================================= */

  .about-section {
    isolation: isolate;
  }


  /* =========================================
     AMBIENT BACKGROUND
     ========================================= */

  .about-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    opacity: 0.08;
    z-index: -1;
  }

  .about-glow-one {
    top: 15%;
    right: -150px;
    background: #a476ff;
    animation: aboutGlowOne 10s ease-in-out infinite;
  }

  .about-glow-two {
    bottom: 5%;
    left: -180px;
    background: #5e4491;
    animation: aboutGlowTwo 12s ease-in-out infinite;
  }


  @keyframes aboutGlowOne {

    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }

    50% {
      transform: translate(-40px, 30px) scale(1.08);
    }

  }


  @keyframes aboutGlowTwo {

    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }

    50% {
      transform: translate(35px, -25px) scale(1.1);
    }

  }


  /* =========================================
     HEADER
     ========================================= */

  .about-header {
    opacity: 0;
    transform: translateY(25px);
    animation:
      aboutFadeUp
      0.8s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }


  .about-label {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--sec);
    font-size: 1.1rem;
  }


  .about-label-line {
    display: block;
    width: 80px;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--sec),
      transparent
    );
  }


  .about-gradient-text {
    background: linear-gradient(
      110deg,
      #dfdfdf 10%,
      #a476ff 55%,
      #d9c9ff 85%
    );

    background-size: 200% auto;

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;

    animation:
      aboutTextShine
      5s
      linear
      infinite;
  }


  @keyframes aboutTextShine {

    to {
      background-position: 200% center;
    }

  }


  .about-roles {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 18px;
    color: var(--white-icon);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
  }


  .role-cross {
    color: var(--sec);
    opacity: 0.6;
  }


  /* =========================================
     ABOUT TEXT
     ========================================= */

  .about-text {
    opacity: 0;
    transform: translateY(25px);

    animation:
      aboutFadeUp
      0.8s
      0.2s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }


  .about-paragraph {
    display: grid;
    grid-template-columns: 3px 1fr;
    gap: 18px;
    align-items: stretch;
  }


  .about-accent {
    width: 3px;
    min-height: 100%;
    border-radius: 4px;

    background: linear-gradient(
      180deg,
      var(--sec),
      rgba(164, 118, 255, 0.15)
    );

    transform-origin: top;
    transform: scaleY(0);

    animation:
      accentGrow
      0.7s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }


  .about-paragraph:nth-child(1) .about-accent {
    animation-delay: 0.45s;
  }

  .about-paragraph:nth-child(2) .about-accent {
    animation-delay: 0.55s;
  }

  .about-paragraph:nth-child(3) .about-accent {
    animation-delay: 0.65s;
  }

  .about-paragraph:nth-child(4) .about-accent {
    animation-delay: 0.75s;
  }


  @keyframes accentGrow {

    to {
      transform: scaleY(1);
    }

  }


  .about-paragraph p {
    color: var(--white-icon);
    font-size: 1.05rem;
    line-height: 1.85;
  }


  .highlight {
    color: var(--white);

    transition:
      color 0.3s ease,
      text-shadow 0.3s ease;
  }


  .about-paragraph:hover .highlight {
    color: var(--sec);

    text-shadow:
      0 0 16px
      rgba(164, 118, 255, 0.22);
  }


  /* =========================================
     RIGHT VISUAL
     ========================================= */

  .about-visual {
    opacity: 0;
    transform: translateY(30px);

    animation:
      aboutFadeUp
      0.9s
      0.35s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }


  /* =========================================
     FEATURE CARD
     ========================================= */

  .about-feature-card {
    position: relative;
    min-height: 300px;
    overflow: hidden;

    border:
      1px solid
      rgba(164, 118, 255, 0.2);

    border-radius: 24px;

    background:
      radial-gradient(
        circle at 50% 45%,
        rgba(164, 118, 255, 0.12),
        transparent 45%
      ),
      rgba(20, 20, 20, 0.72);

    box-shadow:
      inset 0 1px 0
      rgba(255, 255, 255, 0.03),

      0 25px 60px
      rgba(0, 0, 0, 0.22);

    transition:
      transform 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }


  .about-feature-card:hover {
    transform: translateY(-6px);

    border-color:
      rgba(164, 118, 255, 0.4);

    box-shadow:
      inset 0 1px 0
      rgba(255, 255, 255, 0.04),

      0 30px 70px
      rgba(0, 0, 0, 0.3),

      0 0 35px
      rgba(164, 118, 255, 0.06);
  }


  /* =========================================
     FEATURE ORB
     ========================================= */

  .feature-orb {
    position: absolute;

    width: 180px;
    height: 180px;

    left: 50%;
    top: 42%;

    transform:
      translate(-50%, -50%);

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(164, 118, 255, 0.25),
        rgba(164, 118, 255, 0.04) 45%,
        transparent 70%
      );

    filter: blur(8px);

    animation:
      orbPulse
      5s
      ease-in-out
      infinite;
  }


  @keyframes orbPulse {

    0%,
    100% {
      transform:
        translate(-50%, -50%)
        scale(0.95);

      opacity: 0.7;
    }

    50% {
      transform:
        translate(-50%, -50%)
        scale(1.12);

      opacity: 1;
    }

  }


  /* =========================================
     LEARNING BADGE
     ========================================= */

  .feature-top {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 5;
  }


  .learning-badge {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 12px 16px;

    border:
      1px solid
      rgba(255, 255, 255, 0.08);

    border-radius: 15px;

    background:
      rgba(20, 20, 20, 0.7);

    backdrop-filter: blur(12px);

    color: var(--white-icon);

    font-size: 0.8rem;
    line-height: 1.3;
  }


  .learning-dot {
    width: 10px;
    height: 10px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      var(--sec);

    box-shadow:
      0 0 14px
      rgba(164, 118, 255, 0.8);

    animation:
      dotPulse
      2s
      ease-in-out
      infinite;
  }


  @keyframes dotPulse {

    0%,
    100% {
      transform: scale(0.85);
      opacity: 0.7;
    }

    50% {
      transform: scale(1.15);
      opacity: 1;
    }

  }


  /* =========================================
     PROFILE PHOTO
     ========================================= */

  .feature-center {
    position: absolute;

    left: 50%;

    /* Balanced position */
    top: 43%;

    transform:
      translate(-50%, -50%);

    text-align: center;

    z-index: 3;
  }


  .photo-frame {
    position: relative;

    width: 155px;
    height: 155px;

    border-radius: 50%;

    padding: 3px;

    overflow: visible;

    animation:
      photoFloat
      4s
      ease-in-out
      infinite;
  }


  .about-photo {
    position: relative;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    border-radius: 50%;

    z-index: 2;

    filter:
      grayscale(18%)
      contrast(1.05)
      brightness(0.82);

    border:
      1px solid
      rgba(164, 118, 255, 0.35);

    box-shadow:
      0 0 25px
      rgba(164, 118, 255, 0.15),

      0 0 70px
      rgba(164, 118, 255, 0.08);

    transition:
      transform 0.5s ease,
      filter 0.5s ease,
      box-shadow 0.5s ease;
  }


  /* Purple glow behind photo */

  .photo-glow {
    position: absolute;

    inset: -25px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(164, 118, 255, 0.35),
        rgba(164, 118, 255, 0.08) 45%,
        transparent 70%
      );

    filter: blur(15px);

    z-index: 0;

    animation:
      photoGlowPulse
      4s
      ease-in-out
      infinite;
  }


  /* Dark fade over lower portion */

  .photo-overlay {
    position: absolute;

    inset: 3px;

    border-radius: 50%;

    z-index: 3;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        transparent 45%,
        rgba(10, 10, 10, 0.3) 70%,
        rgba(10, 10, 10, 0.75) 100%
      );
  }


  /* Photo hover */

  .about-feature-card:hover .about-photo {
    transform: scale(1.04);

    filter:
      grayscale(0%)
      contrast(1.08)
      brightness(0.9);

    box-shadow:
      0 0 30px
      rgba(164, 118, 255, 0.25),

      0 0 80px
      rgba(164, 118, 255, 0.12);
  }


  /* Floating photo */

  @keyframes photoFloat {

    0%,
    100% {
      transform:
        translateY(0);
    }

    50% {
      transform:
        translateY(-7px);
    }

  }


  /* Breathing glow */

  @keyframes photoGlowPulse {

    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.65;
    }

    50% {
      transform: scale(1.08);
      opacity: 1;
    }

  }


  /* =========================================
     DECORATIVE LINES
     ========================================= */

  .feature-lines {
    display: flex;

    justify-content: center;

    gap: 5px;

    margin-top: 7px;
  }


  .feature-lines span {
    display: block;

    width: 24px;
    height: 2px;

    border-radius: 5px;

    background:
      var(--sec);

    opacity: 0.5;
  }


  .feature-lines span:nth-child(2) {
    width: 38px;
    opacity: 0.8;
  }


  /* =========================================
     FEATURE BOTTOM
     ========================================= */

  .feature-bottom {
    position: absolute;

    bottom: 24px;
    left: 24px;

    display: flex;

    align-items: center;

    gap: 14px;

    z-index: 5;
  }


  .feature-accent-line {
    width: 3px;
    height: 54px;

    border-radius: 5px;

    background:
      var(--sec);

    box-shadow:
      0 0 12px
      rgba(164, 118, 255, 0.35);
  }


  .feature-bottom p {
    color: var(--white);

    font-size: 1.15rem;

    line-height: 1.4;
  }


  .feature-bottom span {
    color: var(--sec);
  }


  /* =========================================
     INFORMATION CARDS
     ========================================= */

  .about-info-grid {
    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    gap: 14px;

    margin-top: 14px;
  }


  .about-info-card {
    display: flex;

    align-items: flex-start;

    gap: 14px;

    min-height: 112px;

    padding: 18px;

    border:
      1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 18px;

    background:
      rgba(20, 20, 20, 0.65);

    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease,
      box-shadow 0.35s ease;
  }


  .about-info-card:hover {
    transform: translateY(-5px);

    border-color:
      rgba(164, 118, 255, 0.3);

    background:
      rgba(25, 25, 25, 0.8);

    box-shadow:
      0 15px 35px
      rgba(0, 0, 0, 0.2);
  }


  .info-icon {
    flex-shrink: 0;

    color:
      var(--sec);
  }


  .info-icon svg {
    width: 27px;
    height: 27px;

    transition:
      transform 0.35s ease,
      filter 0.35s ease;
  }


  .about-info-card:hover .info-icon svg {
    transform:
      scale(1.12);

    filter:
      drop-shadow(
        0 0 7px
        rgba(164, 118, 255, 0.45)
      );
  }


  .about-info-card h3 {
    color:
      var(--white);

    font-size: 0.95rem;

    font-weight: 500;

    margin-bottom: 7px;
  }


  .about-info-card p {
    color:
      var(--white-icon);

    font-size: 0.65rem;

    line-height: 1.7;

    letter-spacing: 0.05em;
  }


  /* =========================================
     GENERAL ANIMATION
     ========================================= */

  @keyframes aboutFadeUp {

    from {
      opacity: 0;

      transform:
        translateY(28px);

      filter:
        blur(6px);
    }

    to {
      opacity: 1;

      transform:
        translateY(0);

      filter:
        blur(0);
    }

  }


  /* =========================================
     MOBILE
     ========================================= */

  @media (max-width: 768px) {

    .about-section {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }


    .about-roles {
      gap: 9px;

      font-size: 0.68rem;

      letter-spacing: 0.13em;
    }


    .about-paragraph p {
      font-size: 0.95rem;

      line-height: 1.75;
    }


    .about-feature-card {
      min-height: 280px;
    }


    .photo-frame {
      width: 145px;
      height: 145px;
    }


    .about-info-card {
      min-height: 105px;

      padding: 15px;
    }


    .about-info-card p {
      font-size: 0.58rem;
    }


    .about-glow {
      width: 260px;
      height: 260px;

      opacity: 0.05;
    }

  }


  /* =========================================
     REDUCED MOTION
     ========================================= */

  @media (prefers-reduced-motion: reduce) {

    .about-header,
    .about-text,
    .about-visual {
      animation: none;

      opacity: 1;

      transform: none;

      filter: none;
    }


    .about-glow-one,
    .about-glow-two,
    .about-gradient-text,
    .feature-orb,
    .learning-dot,
    .photo-frame,
    .photo-glow {
      animation: none;
    }


    .about-accent {
      animation: none;

      transform:
        scaleY(1);
    }


    .about-feature-card,
    .about-info-card,
    .about-photo {
      transition: none;
    }

  }

</style>