---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section
  class="text-[var(--white)] mt-12 md:mt-0 relative overflow-hidden hero-section"
  id="home"
>
  <!-- Ambient background glow -->
  <div class="hero-glow hero-glow-one"></div>
  <div class="hero-glow hero-glow-two"></div>

  <!-- Mouse-following spotlight -->
  <div class="hero-spotlight"></div>

  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14 relative z-10">
    <div class="text-left space-y-4">

      <!-- Introduction -->
      <p
        class="text-md md:text-lg text-[var(--white-icon)] shiny-white hero-item hero-delay-1"
      >
        Hi, I'm <span class="hero-name">Tejas Deore</span>
      </p>

      <!-- Main Hero Content -->
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none hero-item hero-delay-2"
        >
          <span class="hero-heading-line">Computer</span>
          <br />
          <span class="hero-heading-line">Engineering Student</span>
        </h1>

        <p
          class="text-md md:text-2xl text-[var(--white-icon)] hero-item hero-delay-3"
        >
          Exploring{" "}
          <span class="text-[var(--sec)] shiny-sec ai-accent">
            Artificial Intelligence
          </span>,{" "}
          Machine Learning, and software development through practical projects
          and real-world problem solving.
        </p>
      </div>

      <!-- Social Links -->
      <div
        class="flex justify-start gap-2 pt-3 md:pt-6 hero-item hero-delay-4"
      >

        <!-- GitHub -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://github.com/TejasD2007"
          aria-label="GitHub"
          class="social-button text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.linkedin.com/in/tejas-deore-1506343b1/"
          aria-label="LinkedIn"
          class="social-button text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.4202 3.00098 19.6697 3Z"
            ></path>
          </svg>
        </a>

        <!-- Blog -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://unfilteredgenz.blogspot.com"
          aria-label="Blog"
          class="social-button text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Zm-2 13H7v-2h10v2Zm0-4H7v-2h10v2Zm0-4H7V6h10v2Z"
            ></path>
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:deoretejas@gmail.com"
          aria-label="Email"
          class="social-button text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2.1em"
            height="2.1em"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a>

      </div>
    </div>

    <!-- Existing Logo Wall -->
    <LogoWall />

    <!-- Existing Skills + Letter Glitch -->
    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />

      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>


<style is:global>
  /* =========================================
     HERO ENTRANCE
     ========================================= */

  .hero-item {
    opacity: 0;
    transform: translateY(24px);
    filter: blur(7px);
    animation:
      heroReveal 0.9s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }

  .hero-delay-1 {
    animation-delay: 0.1s;
  }

  .hero-delay-2 {
    animation-delay: 0.25s;
  }

  .hero-delay-3 {
    animation-delay: 0.42s;
  }

  .hero-delay-4 {
    animation-delay: 0.58s;
  }

  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(7px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }


  /* =========================================
     HERO HEADING
     ========================================= */

  .hero-heading-line {
    display: inline-block;

    transition:
      transform 0.4s ease,
      text-shadow 0.4s ease;
  }

  .hero-heading-line:hover {
    transform: translateX(6px);

    text-shadow:
      0 0 28px
      rgba(164, 118, 255, 0.12);
  }


  /* =========================================
     NAME
     ========================================= */

  .hero-name {
    display: inline-block;

    color:
      var(--white);

    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  .hero-name:hover {
    color:
      var(--sec);

    transform:
      translateY(-2px);
  }


  /* =========================================
     AI ACCENT
     ========================================= */

  .shiny-sec {
    background:
      linear-gradient(
        135deg,
        #a476ff 25%,
        #eee5ff 50%,
        #a476ff 75%
      );

    background-size:
      400% 100%;

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;

    animation:
      shine 3s linear infinite;
  }

  .ai-accent {
    display:
      inline-block;

    transition:
      transform 0.35s ease,
      filter 0.35s ease;
  }

  .ai-accent:hover {
    transform:
      translateY(-2px)
      scale(1.025);

    filter:
      drop-shadow(
        0 0 12px
        rgba(164, 118, 255, 0.4)
      );
  }

  @keyframes shine {
    0% {
      background-position:
        100% 50%;
    }

    30%,
    70% {
      background-position:
        0% 50%;
    }
  }


  /* =========================================
     SOCIAL BUTTONS
     ========================================= */

  .social-button {
    position:
      relative;

    overflow:
      hidden;

    transform:
      translateY(0);
  }

  .social-button::before {
    content:
      "";

    position:
      absolute;

    inset:
      0;

    background:
      radial-gradient(
        circle at center,
        rgba(164, 118, 255, 0.18),
        transparent 65%
      );

    opacity:
      0;

    transform:
      scale(0.5);

    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .social-button:hover {
    transform:
      translateY(-5px);

    border-color:
      rgba(164, 118, 255, 0.35);

    box-shadow:
      0 10px 30px
      rgba(0, 0, 0, 0.2);
  }

  .social-button:hover::before {
    opacity:
      1;

    transform:
      scale(1.3);
  }

  .social-button svg {
    position:
      relative;

    z-index:
      1;

    transition:
      transform 0.3s ease;
  }

  .social-button:hover svg {
    transform:
      scale(1.08);
  }


  /* =========================================
     AMBIENT GLOW
     ========================================= */

  .hero-glow {
    position:
      absolute;

    width:
      420px;

    height:
      420px;

    border-radius:
      50%;

    pointer-events:
      none;

    filter:
      blur(70px);

    opacity:
      0.13;

    z-index:
      0;
  }

  .hero-glow-one {
    top:
      60px;

    left:
      8%;

    background:
      #a476ff;

    animation:
      glowFloatOne
      9s
      ease-in-out
      infinite;
  }

  .hero-glow-two {
    top:
      180px;

    right:
      8%;

    background:
      #5e4491;

    animation:
      glowFloatTwo
      11s
      ease-in-out
      infinite;
  }

  @keyframes glowFloatOne {
    0%,
    100% {
      transform:
        translate3d(0, 0, 0)
        scale(1);
    }

    50% {
      transform:
        translate3d(35px, 20px, 0)
        scale(1.08);
    }
  }

  @keyframes glowFloatTwo {
    0%,
    100% {
      transform:
        translate3d(0, 0, 0)
        scale(1);
    }

    50% {
      transform:
        translate3d(-30px, 25px, 0)
        scale(1.1);
    }
  }


  /* =========================================
     MOUSE SPOTLIGHT
     ========================================= */

  .hero-spotlight {
    position:
      absolute;

    width:
      280px;

    height:
      280px;

    left:
      var(--mouse-x, 50%);

    top:
      var(--mouse-y, 30%);

    transform:
      translate(-50%, -50%);

    border-radius:
      50%;

    pointer-events:
      none;

    background:
      radial-gradient(
        circle,
        rgba(164, 118, 255, 0.08) 0%,
        rgba(164, 118, 255, 0.025) 35%,
        transparent 70%
      );

    filter:
      blur(8px);

    opacity:
      0;

    transition:
      opacity 0.4s ease;

    z-index:
      1;
  }

  .hero-section:hover
  .hero-spotlight {
    opacity:
      1;
  }


  /* =========================================
     MOBILE
     ========================================= */

  @media (max-width: 768px) {

    .hero-glow {
      width:
        280px;

      height:
        280px;

      opacity:
        0.08;
    }

    .hero-spotlight {
      display:
        none;
    }

    .hero-heading-line:hover {
      transform:
        none;

      text-shadow:
        none;
    }

    .social-button:hover {
      transform:
        translateY(-3px);
    }
  }


  /* =========================================
     REDUCED MOTION
     ========================================= */

  @media (prefers-reduced-motion: reduce) {

    .hero-item {
      animation:
        none;

      opacity:
        1;

      transform:
        none;

      filter:
        none;
    }

    .hero-glow-one,
    .hero-glow-two,
    .shiny-sec {
      animation:
        none;
    }

    .hero-heading-line,
    .hero-name,
    .ai-accent,
    .social-button,
    .social-button svg {
      transition:
        none;
    }
  }
</style>


<script>
  /*
   * Explicitly type the queried element as HTMLElement.
   * This fixes TypeScript's "style does not exist on Element" error.
   */
  const heroSection =
    document.querySelector(
      ".hero-section"
    ) as HTMLElement | null;


  /*
   * Only enable the mouse spotlight on devices
   * with a precise pointer such as a mouse.
   */
  if (
    heroSection &&
    window.matchMedia(
      "(pointer: fine)"
    ).matches
  ) {

    /*
     * Explicitly type the event as MouseEvent.
     * This fixes the clientX/clientY TypeScript errors.
     */
    heroSection.addEventListener(
      "mousemove",
      (event: MouseEvent) => {

        const rect =
          heroSection.getBoundingClientRect();


        const x =
          event.clientX -
          rect.left;


        const y =
          event.clientY -
          rect.top;


        heroSection.style.setProperty(
          "--mouse-x",
          `${x}px`
        );


        heroSection.style.setProperty(
          "--mouse-y",
          `${y}px`
        );

      }
    );

  }
</script>